# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://auto_calls:auto_calls@db:5432/auto_calls

# --- Vapi ---
VAPI_API_KEY=
# Legacy static webhook secret (fallback auth mechanism)
VAPI_WEBHOOK_SECRET=
# HMAC secret configured on the Vapi credential (preferred auth mechanism)
VAPI_WEBHOOK_HMAC_SECRET=
VAPI_API_BASE_URL=https://api.vapi.ai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Zadarma (per tenant, example for tenant "A") ---
ZADARMA_TENANT_A_SIP_USERNAME=
ZADARMA_TENANT_A_SIP_PASSWORD=

# --- Google Calendar (Calendar Tools) ---
# Path to the service account JSON key, as mounted inside the container.
# One key for the whole app; each tenant shares their own Google Calendar
# with the service account's email (see README "Calendar Tools").
GOOGLE_SERVICE_ACCOUNT_FILE=/srv/app/secrets/google-service-account.json
